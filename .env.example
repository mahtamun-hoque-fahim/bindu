# ─── Neon (PostgreSQL) ─────────────────────────────────────────────────────
# Pooled connection — used at app runtime
DATABASE_URL=
# Direct (unpooled) — used by drizzle-kit for migrations
DATABASE_URL_UNPOOLED=

# ─── App ───────────────────────────────────────────────────────────────────
NEXT_PUBLIC_APP_URL=http://localhost:3000

# ─── Auth ──────────────────────────────────────────────────────────────────
# 32 bytes — `openssl rand -base64 32`
# Used to sign session cookies (HS256)
SESSION_SECRET=

# ─── Upstash Redis (rate limiting + IP bans) ───────────────────────────────
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=
